    var selectHandler: (String, NSRect) -> Void = { _, _ in }
    init(view: EBlockRowView, removeRecent: ((String) -> Void)? = nil) {
        self.view = view
        self.removeRecent = removeRecent
    }
    __BUILTIN_MENU__
}

struct TelegramMediaFile { let fileId: MediaId }
struct StickerPackItem { let file: TelegramMediaFile }
final class EmojiesSectionRowItem {
    struct Item { let rect: NSRect; let item: StickerPackItem? }
    var items: [Item]
    init(_ ids: [MediaId]) {
        items = ids.enumerated().map { index, id in
            Item(rect: NSRect(x: index * 40, y: 0, width: 34, height: 34), item: StickerPackItem(file: TelegramMediaFile(fileId: id)))
        }
    }
}
final class EmojiesSectionRowView: NSView {
    let contentView = FlippedView(frame: NSRect(x: 12, y: 8, width: 100, height: 34))
    var item: AnyObject?
    var itemUnderMouse: StickerPackItem?
    override var isFlipped: Bool { true }
    init(_ ids: [MediaId]) {
        item = EmojiesSectionRowItem(ids)
        super.init(frame: NSRect(x: 0, y: 0, width: 140, height: 50))
        addSubview(contentView)
    }
    required init?(coder: NSCoder) { fatalError() }
    __ANIMATED_HIT__
}

final class AnimatedRemovalMenu {
