extension NSFont {
    static func normal(_ size: CGFloat) -> NSFont { .systemFont(ofSize: size) }
}
extension NSAttributedString {
    static func initialize(string: String, font: NSFont) -> NSAttributedString {
        NSAttributedString(string: string, attributes: [.font: font])
    }
}

public struct MediaId: Hashable, Codable {
    public let namespace: Int32
    public let id: Int64
}

public final class PreferencesEntry {
    private let value: Any
    public init<T: Codable>(_ value: T) { self.value = value }
    public func get<T: Codable>(_ type: T.Type) -> T? { value as? T }
}

public enum ApplicationSpecificPreferencesKeys {
    public static let recentEmoji = "recentEmoji"
}

public struct PreferencesView {
    public let values: [String: PreferencesEntry]
}

public final class Transaction {
    let postbox: Postbox
    init(_ postbox: Postbox) { self.postbox = postbox }
    public func updatePreferencesEntry(key: String, _ update: (PreferencesEntry?) -> PreferencesEntry?) {
        postbox.values[key] = update(postbox.values[key])
    }
}

public final class Postbox {
    var values: [String: PreferencesEntry] = [:]
    var transactions = 0
    init(_ value: RecentUsedEmoji? = nil) { replace(value) }
    func replace(_ value: RecentUsedEmoji?) {
        values[ApplicationSpecificPreferencesKeys.recentEmoji] = value.map(PreferencesEntry.init)
    }
    var current: RecentUsedEmoji {
        values[ApplicationSpecificPreferencesKeys.recentEmoji]?.get(RecentUsedEmoji.self) ?? .defaultSettings
    }
    public func transaction<T>(_ action: @escaping (Transaction) -> T) -> Signal<T, NoError> {
        return Signal { subscriber in
            self.transactions += 1
            subscriber.putNext(action(Transaction(self)))
            subscriber.putCompletion()
            return EmptyDisposable
        }
    }
    public func preferencesView(keys: [String]) -> Signal<PreferencesView, NoError> {
        return .single(PreferencesView(values: values.filter { keys.contains($0.key) }))
    }
}

final class Account {
    let postbox = Postbox()
}

enum MenuItemMode { case normal, destruct }
class ContextMenuItem {
    let title: String
    let handler: () -> Void
    let itemMode: MenuItemMode
    init(_ title: String, handler: @escaping () -> Void = {}, itemMode: MenuItemMode = .normal, itemImage: String? = nil) {
        self.title = title
        self.handler = handler
        self.itemMode = itemMode
    }
}
final class ContextSeparatorItem: ContextMenuItem {
    init() { super.init("separator") }
}
final class EmojiToleranceContextMenuItem: ContextMenuItem {
    let emoji: String
    let callback: (String?) -> Void
    init(emoji: String, callback: @escaping (String?) -> Void) {
        self.emoji = emoji
        self.callback = callback
        super.init("skin-tone")
    }
}
